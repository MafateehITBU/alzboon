DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alzboon?schema=public"
# npm test rewrites this to the sibling *_test database (e.g. alzboon_test). Create and migrate that DB before running tests.
STORAGE_ROOT="/var/www/alzboon/shared/uploads"
APP_URL="http://localhost:3000"
NODE_ENV="development"
TRUST_PROXY="false"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"

# Contact enquiry notifications (optional). When set, new public contact submissions
# email active Super Admins and Admins with MANAGE_CONTACT_ENQUIRIES.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Awwad AlZboon <noreply@example.com>"
