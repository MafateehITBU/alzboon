DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alzboon?schema=public"
# npm test rewrites this to the sibling *_test database (e.g. alzboon_test). Create and migrate that DB before running tests.
STORAGE_ROOT="/var/www/alzboon/shared/uploads"
APP_URL="http://localhost:3000"
NODE_ENV="development"
TRUST_PROXY="false"
# Initial Super Admins (seeded on deploy via `npm run admin:bootstrap`; idempotent).
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL_2="admin2@example.com"
SUPER_ADMIN_PASSWORD_2="replace-with-a-strong-password"
SUPER_ADMIN_NAME_2="Super Admin"

# Required for admin login OTP (6-digit email code). Also used for contact/newsletter mail.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Awwad AlZboon <noreply@example.com>"

# GitHub Actions auto-deploy secrets (set in the repo, not in this file):
# DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, DEPLOY_REPO_URL, optional DEPLOY_PORT
